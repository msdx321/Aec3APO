; AEC3APO component INF

[Version]
Signature   = "$WINDOWS NT$"
Class       = AudioProcessingObject
ClassGuid   = {5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider    = %ProviderName%
DriverVer = 07/06/2026,23.15.3.102
CatalogFile = aec3apo.cat
PnpLockDown = 1

[Manufacturer]
%MfgName% = Aec3ApoComponent,NTamd64.10.0...26100

[Aec3ApoComponent.NTamd64.10.0...26100]
%Apo.ComponentDesc% = Aec3ApoComponent_Install, SWC\VEN_MSDX&AUDIO_EFFECTPACK_AECAPO

[Aec3ApoComponent_Install.NTamd64]
AddReg    = Aec3ApoComponent_AddReg
CopyFiles = Aec3ApoComponent_CopyFiles

[Aec3ApoComponent_CopyFiles]
AecApo.dll

[Aec3ApoComponent_Install.NTamd64.Services]
AddService=,2    ; no function driver, install a null driver.

[Aec3ApoComponent_AddReg]
; APO COM registration
HKR,Classes\CLSID\%AEC_EFFECTPACK_FX_MODE_CLSID%,,,%APO_MFX_FriendlyName%
HKR,Classes\CLSID\%AEC_EFFECTPACK_FX_MODE_CLSID%\InProcServer32,,%REG_EXPAND_SZ%,%13%\AecApo.dll
HKR,Classes\CLSID\%AEC_EFFECTPACK_FX_MODE_CLSID%\InProcServer32,ThreadingModel,,"Both"

; APO registration
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"FriendlyName",,%APO_MFX_FriendlyName%
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"Copyright",,%Copyright%
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"MajorVersion",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"MinorVersion",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"Flags", %REG_DWORD%,%APO_FLAG_AEC%
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"MinInputConnections",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"MaxInputConnections",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"MinOutputConnections",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"MaxOutputConnections",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"MaxInstances",%REG_DWORD%,0xffffffff
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"NumAPOInterfaces",%REG_DWORD%,1
HKR,AudioEngine\AudioProcessingObjects\%AEC_EFFECTPACK_FX_MODE_CLSID%,"APOInterface0",,"{FD7F2B29-24D0-4B5C-B177-592C39F9CA10}"

; Friendly Name
HKR,,FriendlyName,,%Apo.ComponentDesc%

; Effect pack registration
HKR,EffectPackRegistration\%EFFECT_CLSID%,%PKEY_FX_EffectPackSchema_Version%, ,%PKEY_FX_EffectPack_Schema_Internal_V1%
HKR,EffectPackRegistration\%EFFECT_CLSID%,%PKEY_ItemNameDisplay%, ,%Effect_Pack_FriendlyName%
HKR,EffectPackRegistration\%EFFECT_CLSID%,%PKEY_FX_Author%, ,%Effect_Pack_Author%
HKR,EffectPackRegistration\%EFFECT_CLSID%,%PKEY_FX_MEP_UserInterfaceClsid%,%REG_SZ%,%HSA_COM_CLASS_CLSID%
HKR,EffectPackRegistration\%EFFECT_CLSID%,%PKEY_FX_VersionMajor%, %REG_DWORD%, 1
HKR,EffectPackRegistration\%EFFECT_CLSID%,%PKEY_FX_VersionMinor%, %REG_DWORD%, 1
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties,%PKEY_FX_ApplyToCapture%, %REG_DWORD%, 1
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties,%PKEY_FX_Enumerator%,%REG_MULTI_SZ%,"*"
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties,%PKEY_FX_Association%,%REG_MULTI_SZ%,%KSNODETYPE_MICROPHONE%,%KSNODETYPE_DESKTOP_MICROPHONE%,%KSNODETYPE_PERSONAL_MICROPHONE%,%KSNODETYPE_OMNI_DIRECTIONAL_MICROPHONE%,%KSNODETYPE_MICROPHONE_ARRAY%,%KSNODETYPE_PROCESSING_MICROPHONE_ARRAY%,%KSNODETYPE_HEADSET%,%KSNODETYPE_HFP_SIDEBAND_HEADSET%,%KSNODETYPE_HEADSET_MICROPHONE%,%KSNODETYPE_ECHO_CANCELING_SPEAKERPHONE%,%KSNODETYPE_ECHO_SUPPRESSING_SPEAKERPHONE%,%KSNODETYPE_SPEAKERPHONE_NO_ECHO_REDUCTION%
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties\FX\0\%AEC_EFFECTPACK_APO_MFX_CONTEXT%\Default,%PKEY_MFX_AEC_Effect_State%,%REG_DWORD%,0xffffffff
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties\FX\0\%AEC_EFFECTPACK_APO_MFX_CONTEXT%\Default,%PKEY_MFX_AEC_Default_Effect_Description%,%REG_SZ%,"Acoustic echo cancellation for capture devices"
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties\FX\0\%AEC_EFFECTPACK_APO_MFX_CONTEXT%\User
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties,%PKEY_FX_ModeEffectClsid%,,%AEC_EFFECTPACK_FX_MODE_CLSID%
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties,%PKEY_CompositeFX_ModeEffectClsid%,%REG_MULTI_SZ%,%AEC_EFFECTPACK_FX_MODE_CLSID%
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%,%AUDIO_SIGNALPROCESSINGMODE_SPEECH%,%AUDIO_SIGNALPROCESSINGMODE_RAW%
HKR,EffectPackRegistration\%EFFECT_CLSID%\FxProperties,%PKEY_FX_ExcludeForHWIDs%,%REG_MULTI_SZ%,"ROOT\*","*VirtualAudio*","*Virtual_Audio*"

HKR,Classes\CLSID\%HSA_COM_CLASS_CLSID%,,,%HSA_FriendlyName%
HKR,Classes\CLSID\%HSA_COM_CLASS_CLSID%\InProcServer32,,%REG_EXPAND_SZ%,%13%\AecApo.dll
HKR,Classes\CLSID\%HSA_COM_CLASS_CLSID%\InProcServer32,ThreadingModel,,"Both"
HKR,Classes\CLSID\%HSA_COM_CLASS_CLSID%\Version,,,"1.1"

[SourceDisksNames]
1 = Disk

[SourceDisksFiles]
AecApo.dll = 1

[DestinationDirs]
Aec3ApoComponent_CopyFiles = 13 ; 13=Package's DriverStore directory

[SignatureAttributes]
AecApo.dll  = SignatureAttributes.PETrust

[SignatureAttributes.PETrust]
PETrust = true

